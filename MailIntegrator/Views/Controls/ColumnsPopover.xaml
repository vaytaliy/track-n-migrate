<UserControl x:Class="MailIntegrator.Views.Controls.ColumnsPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="280">

    <!--
        Column selector shown under the "Колонки" button. The DataContext is a
        GridColumnLayoutViewModel supplied by the main window; the control only renders the options.
    -->
    <UserControl.Resources>
        <!-- One checkbox row: optional padlock, checkbox, caption. -->
        <DataTemplate x:Key="ColumnOptionTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Style="{StaticResource SmallIconPathStyle}"
                      Data="{StaticResource LockGeometry}"
                      Stroke="{StaticResource ForegroundMutedBrush}"
                      Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />

                <CheckBox Grid.Column="1"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggle}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource PopoverOptionTextStyle}"
                           Text="{Binding Header}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PopoverCardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                       FontSize="{StaticResource FontSizeMedium}"
                       Text="Настройка колонок" />

            <ItemsControl Margin="0,10,0,0"
                          ItemTemplate="{StaticResource ColumnOptionTemplate}"
                          ItemsSource="{Binding GeneralColumns}" />

            <Separator Style="{StaticResource PopoverSeparatorStyle}" />

            <TextBlock Style="{StaticResource PopoverSectionHeaderStyle}" Text="Системные" />
            <ItemsControl ItemTemplate="{StaticResource ColumnOptionTemplate}"
                          ItemsSource="{Binding SystemColumns}" />

            <Separator Style="{StaticResource PopoverSeparatorStyle}" />

            <Button Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ResetToDefaultsCommand}"
                    Content="Сбросить по умолчанию" />
        </StackPanel>
    </Border>
</UserControl>
