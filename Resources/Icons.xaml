<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icon geometries. All are authored on a 16x16 canvas and rendered with the shared
        IconPathStyle defined in Controls.xaml.
    -->

    <!-- Padlock marking a parcel that was exported to 1C and is therefore read-only. -->
    <PathGeometry x:Key="LockGeometry"
                  Figures="M 5.5,7 V 4.75 A 3.25,3.25 0 0 1 12,4.75 V 7 M 3.5,7 H 14 V 15.5 H 3.5 Z" />

    <!-- Plus sign on the "add parcel" button of the draft row. -->
    <PathGeometry x:Key="AddGeometry" Figures="M 8,2.5 V 13.5 M 2.5,8 H 13.5" />

    <!-- Pencil affordance indicating that a cell can be edited. -->
    <PathGeometry x:Key="PencilGeometry"
                  Figures="M 2,17 V 14 L 13,3 L 16,6 L 5,17 Z M 11,5 L 14,8" />

    <!-- Chain link shown next to a tracking number. -->
    <PathGeometry x:Key="LinkGeometry"
                  Figures="M 6.5,9.5 A 2.5,2.5 0 0 0 10,9.5 L 12.5,7 A 2.5,2.5 0 0 0 9,3.5 L 7.5,5 M 9.5,6.5 A 2.5,2.5 0 0 0 6,6.5 L 3.5,9 A 2.5,2.5 0 0 0 7,12.5 L 8.5,11" />

    <!-- Success checkmark, also used by the "Доставлено" status badge. -->
    <PathGeometry x:Key="CheckGeometry" Figures="M 2.5,8.5 L 6.5,12.5 L 15,3" />

    <!-- Failure warning triangle with an exclamation mark. -->
    <PathGeometry x:Key="WarningGeometry"
                  Figures="M 9,2.5 L 16.5,15.5 H 1.5 Z M 9,7 V 11.5 M 9,13.2 V 13.6" />

    <!-- "Request parcel statuses" toolbar button. -->
    <PathGeometry x:Key="RefreshGeometry"
                  Figures="M 4.6,2.9 A 5.5,5.5 0 1 1 2.5,8 M 4.6,2.9 V 6.3 M 4.6,2.9 H 1.2" />

    <!-- "Export to 1C" toolbar button. -->
    <PathGeometry x:Key="ExportGeometry"
                  Figures="M 8,1.5 V 10 M 4.75,4.75 L 8,1.5 L 11.25,4.75 M 2.5,9.5 V 14.5 H 13.5 V 9.5" />

    <!-- Settings dialog entry point, drawn as sliders. -->
    <PathGeometry x:Key="SettingsGeometry"
                  Figures="M 2,4.5 H 14 M 5.5,2.5 V 6.5 M 2,11.5 H 14 M 10.5,9.5 V 13.5" />

    <!-- "В пути" status badge. -->
    <PathGeometry x:Key="InTransitGeometry"
                  Figures="M 2,8 H 12 M 8.5,4.5 L 12,8 L 8.5,11.5" />

    <!-- "Ожидает отправки" status badge. -->
    <PathGeometry x:Key="ClockGeometry"
                  Figures="M 8,3.5 A 4.5,4.5 0 1 0 8,12.5 A 4.5,4.5 0 1 0 8,3.5 Z M 8,5.5 V 8.2 L 10.2,9.6" />

    <!-- Document/box icon used by the window title artwork. -->
    <PathGeometry x:Key="ParcelGeometry"
                  Figures="M 2,5 L 8,2 L 14,5 V 11 L 8,14 L 2,11 Z M 2,5 L 8,8 L 14,5 M 8,8 V 14" />

</ResourceDictionary>
